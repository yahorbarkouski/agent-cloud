# Local-only database. Do not reuse these credentials for an exposed deployment.
DATABASE_URL=postgresql://agentcloud:local-development-only@127.0.0.1:55439/agentcloud
HOST=127.0.0.1
PORT=4319
PUBLIC_URL=http://127.0.0.1:4319
PROVIDER=simulated
LOG_LEVEL=info
ACLD_CREDENTIALS=.local/admin.credentials.json

# Hetzner remains off unless explicitly selected and configured for a bounded test.
# HCLOUD_TOKEN_FILE=.local/hcloud-token
# HCLOUD_IMAGE_ID=
# HCLOUD_FIREWALL_ID=
# Set the currency returned by your account pricing endpoint. No currency conversion.
PROVIDER_CURRENCY=EUR
MAX_PROVIDER_HOURLY=0.02
# MAX_LIVE_MACHINES=2
