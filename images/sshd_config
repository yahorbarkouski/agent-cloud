Port 22
HostKey /var/lib/agent-cloud/keys/ssh_host_ed25519_key
Include /var/lib/agent-cloud/ssh/*.conf
TrustedUserCAKeys /usr/lib/agent-cloud/ssh_user_ca.pub
AuthorizedPrincipalsFile /var/lib/agent-cloud/probe-principals
AuthorizedKeysFile none
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
UsePAM yes
AllowUsers agent-probe
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
PermitUserEnvironment no
MaxAuthTries 3
LogLevel INFO
